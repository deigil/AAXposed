<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating controller: MIUI style.
  - Pill panel + ultra-thin stroke (0.5dp), avoiding Material's thick stroke;
  - Uniform 44dp icon buttons with circular ripple (bg_window_btn);
  - All colors use Theme.AADisplay.Window's colorPrimaryContainer /
    colorOnPrimaryContainer / colorOutline, switching automatically for light/dark mode.
  Note: cv_handle / cv_panel / ll_panel IDs and sizes are read by DisplayWindow's
  docking logic (applyControllerDockPosition); do not rename.
  The root layout reserves @dimen/window_shadow_pad padding for card shadow drawing
  (the window is WRAP_CONTENT, so without padding the shadow would be clipped by the window surface);
  the card is offset from the window origin by one pad, so docking coordinates in
  applyControllerDockPosition must subtract it.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/window_shadow_pad">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_handle"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="?colorPrimaryContainer"
        app:cardCornerRadius="@dimen/window_handle_radius"
        app:cardElevation="@dimen/window_panel_elevation"
        app:strokeColor="?colorOutline"
        app:strokeWidth="@dimen/window_stroke_width">

        <ImageButton
            android:id="@+id/ib_handle"
            android:layout_width="@dimen/window_btn_size"
            android:layout_height="@dimen/window_btn_size"
            android:background="@drawable/bg_window_btn"
            android:contentDescription="@string/controller_open_menu"
            android:padding="@dimen/window_btn_padding"
            android:src="@drawable/ic_monitor_24"
            app:tint="?colorOnPrimaryContainer" />
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_panel"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?colorPrimaryContainer"
        app:cardCornerRadius="@dimen/window_panel_radius"
        app:cardElevation="@dimen/window_panel_elevation"
        app:strokeColor="?colorOutline"
        app:strokeWidth="@dimen/window_stroke_width">

        <ImageButton
            android:id="@+id/ib_expand"
            android:layout_width="@dimen/window_btn_size"
            android:layout_height="@dimen/window_btn_size"
            android:layout_margin="@dimen/window_panel_padding"
            android:background="@drawable/bg_window_btn"
            android:padding="@dimen/window_btn_padding"
            android:src="@drawable/ic_fullscreen_24"
            android:visibility="gone"
            app:tint="?colorOnPrimaryContainer" />

        <LinearLayout
            android:id="@+id/ll_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/window_panel_padding"
            android:visibility="visible">

            <ImageButton
                android:id="@+id/ib_hide_controller"
                android:layout_width="@dimen/window_btn_size"
                android:layout_height="@dimen/window_btn_size"
                android:background="@drawable/bg_window_btn"
                android:contentDescription="@string/controller_hide_menu"
                android:padding="@dimen/window_btn_padding"
                android:src="@drawable/ic_close_24"
                app:tint="?colorOnPrimaryContainer" />

            <ImageButton
                android:id="@+id/ib_extinguish"
                android:layout_width="@dimen/window_btn_size"
                android:layout_height="@dimen/window_btn_size"
                android:layout_marginTop="@dimen/window_btn_gap"
                android:background="@drawable/bg_window_btn"
                android:contentDescription="@string/controller_extinguish"
                android:padding="@dimen/window_btn_padding"
                android:src="@drawable/ic_power_settings_new_24"
                android:visibility="gone"
                app:tint="?colorOnPrimaryContainer"
                tools:visibility="visible" />

            <Button
                android:id="@+id/tv_destroy_time"
                android:layout_width="@dimen/window_btn_size"
                android:layout_height="@dimen/window_btn_size"
                android:layout_marginTop="@dimen/window_btn_gap"
                android:background="@drawable/bg_window_btn"
                android:fontFamily="sans-serif-medium"
                android:padding="0dp"
                android:singleLine="true"
                android:text="110s"
                android:textAllCaps="false"
                android:textColor="?colorOnPrimaryContainer"
                android:textSize="@dimen/window_destroy_text_size"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageButton
                android:id="@+id/ib_mirror_display"
                android:layout_width="@dimen/window_btn_size"
                android:layout_height="@dimen/window_btn_size"
                android:layout_marginTop="@dimen/window_btn_gap"
                android:background="@drawable/bg_window_btn"
                android:contentDescription="@string/controller_mirror"
                android:padding="@dimen/window_btn_padding"
                android:src="@drawable/ic_monitor_24"
                android:visibility="gone"
                app:tint="?colorOnPrimaryContainer"
                tools:visibility="visible" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
