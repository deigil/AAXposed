<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon-mode item for the recents panel: shows only app icon + name without loading task snapshots.
  Used by the phone floating window (snapshot thumbnails would overflow wrap_content cards and are unreadable when scaled down);
  AaRecentTaskFragment on the head unit still uses snapshot mode via @layout/recent_task.
  IDs (iv_icon / tv_name) match recent_task.xml so DisplayRecyclerViewAdapter can reuse both.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_recent_task_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingVertical="@dimen/mirror_recent_item_padding">

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/mirror_recent_icon_size"
        android:layout_height="@dimen/mirror_recent_icon_size"
        android:contentDescription="@string/mirror_recent_task"
        android:scaleType="fitCenter"
        tools:srcCompat="@drawable/ic_round_check_circle_24" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tv_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="10sp"
        tools:text="@string/app_name" />
</LinearLayout>
