<?xml version="1.0" encoding="utf-8"?>
<!--
  Phone mirror window: MIUI freeform style.
  - The window itself is a WRAP_CONTENT floating window, no longer full-screen and no scrim;
    touches outside the card pass directly through to the underlying app;
  - Top bar ll_mirror_top_bar and bottom nav bar rl_mirror_nav are both drag areas for moving the window;
  - Bottom-right iv_resize drags to scale proportionally; long-press resets to default size;
  - Recents panel ll_recent_task overlays the head unit screen instead of occupying the full screen.
  IDs (cv_app / sv_mirror / ll_mirror_top_bar / rl_mirror_nav / iv_resize / ib_close /
  ll_recent_task / rv_recent_task_left,right, etc.) are referenced directly by DisplayWindow; do not rename.
  The root layout reserves @dimen/mirror_window_shadow_pad padding for card shadow drawing;
  mirror_card_elevation must be significantly smaller than this padding, otherwise the shadow gradient will be clipped by the window bounds.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:fitsSystemWindows="false"
    android:padding="@dimen/mirror_window_shadow_pad">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_app"
        style="@style/Widget.Material3.CardView.Filled"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?colorPrimaryContainer"
        app:cardCornerRadius="@dimen/mirror_card_radius"
        app:cardElevation="@dimen/mirror_card_elevation"
        app:strokeColor="?colorOutline"
        app:strokeWidth="@dimen/window_stroke_width">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top bar: drag to move the entire floating window -->
            <RelativeLayout
                android:id="@+id/ll_mirror_top_bar"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mirror_top_bar_height"
                android:paddingHorizontal="10dp">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/tv_virtual_display_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.5"
                    android:textColor="?colorOnPrimaryContainer"
                    android:textSize="11sp"
                    tools:text="800*480,160" />
                <View
                    android:id="@+id/v_drag_pill"
                    android:layout_width="@dimen/mirror_drag_pill_width"
                    android:layout_height="@dimen/mirror_drag_pill_height"
                    android:layout_centerInParent="true"
                    android:alpha="0.3"
                    android:background="@drawable/bg_drag_pill" />

                <ImageButton
                    android:id="@+id/ib_close"
                    android:layout_width="@dimen/mirror_top_btn_size"
                    android:layout_height="@dimen/mirror_top_btn_size"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_window_btn"
                    android:contentDescription="@string/mirror_close"
                    android:padding="6dp"
                    android:src="@drawable/ic_close_24"
                    app:tint="?colorOnPrimaryContainer" />
            </RelativeLayout>
            <!-- Head unit screen + overlaid recents panel -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <SurfaceView
                    android:id="@+id/sv_mirror"
                    android:layout_width="800px"
                    android:layout_height="480px" />

                <!--
                  Dimensions are written by DisplayWindow.updateRecentTaskPanelSize() based on sv_mirror's
                  actual pixels: if match_parent were used here, FrameLayout during wrap_content
                  measurement would first measure RecyclerView with AT_MOST, stretching the card taller than
                  the head unit screen and causing the panel to overflow the floating window.
                -->
                <LinearLayout
                    android:id="@+id/ll_recent_task"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/window_recent_scrim"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_recent_task_left"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:padding="4dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        tools:context=".ui.aa.fragment.AaRecentTaskFragment"
                        tools:listitem="@layout/recent_task_icon" />

                    <View
                        android:layout_width="0.5dp"
                        android:layout_height="match_parent"
                        android:alpha="0.3"
                        android:background="?colorOnPrimaryContainer" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_recent_task_right"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:clipToPadding="false"
                        android:padding="4dp"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        tools:context=".ui.aa.fragment.AaRecentTaskFragment"
                        tools:listitem="@layout/recent_task_icon" />
                </LinearLayout>
            </FrameLayout>
            <!-- Bottom navigation bar: dragging empty area also moves window; bottom-right is resize handle -->
            <RelativeLayout
                android:id="@+id/rl_mirror_nav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <ImageButton
                    android:id="@+id/ib_back"
                    android:layout_width="@dimen/mirror_nav_btn_size"
                    android:layout_height="@dimen/mirror_nav_btn_size"
                    android:layout_toStartOf="@id/ib_home"
                    android:background="@drawable/bg_window_btn"
                    android:contentDescription="@string/mirror_back"
                    android:padding="@dimen/mirror_nav_btn_padding"
                    android:src="@drawable/ic_arrow_back_24"
                    app:tint="?colorOnPrimaryContainer" />

                <ImageButton
                    android:id="@+id/ib_home"
                    android:layout_width="@dimen/mirror_nav_btn_size"
                    android:layout_height="@dimen/mirror_nav_btn_size"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_window_btn"
                    android:contentDescription="@string/mirror_home"
                    android:padding="@dimen/mirror_nav_btn_padding"
                    android:src="@drawable/ic_home_24"
                    app:tint="?colorOnPrimaryContainer" />

                <ImageButton
                    android:id="@+id/ib_recent_task"
                    android:layout_width="@dimen/mirror_nav_btn_size"
                    android:layout_height="@dimen/mirror_nav_btn_size"
                    android:layout_toEndOf="@id/ib_home"
                    android:background="@drawable/bg_window_btn"
                    android:contentDescription="@string/mirror_recent_task"
                    android:padding="@dimen/mirror_nav_btn_padding"
                    android:src="@drawable/ic_fullscreen_24"
                    app:tint="?colorOnPrimaryContainer" />

                <ImageView
                    android:id="@+id/iv_resize"
                    android:layout_width="@dimen/mirror_resize_size"
                    android:layout_height="@dimen/mirror_resize_size"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:alpha="0.6"
                    android:background="@drawable/bg_window_btn"
                    android:contentDescription="@string/mirror_resize"
                    android:padding="7dp"
                    android:src="@drawable/ic_resize_24"
                    app:tint="?colorOnPrimaryContainer" />
            </RelativeLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
