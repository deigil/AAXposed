<resources>
    <!-- Base application theme: miuix look (light gray background + blue accent) -->
    <style name="Theme.AADisplay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- PreferenceFragmentCompat resolves preferenceTheme in onCreate;
             runtime applyStyle is too late, so it must be set on the Activity theme -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.Miuix</item>
        <item name="materialSwitchStyle">@style/Widget.Material3.CompoundButton.MaterialSwitch</item>

        <item name="android:windowBackground">@color/miuix_page_background</item>
        <item name="colorPrimary">@color/miuix_blue</item>
        <item name="colorSurface">@color/miuix_card</item>
        <item name="colorSurfaceContainer">@color/miuix_card</item>
        <item name="android:textColorPrimary">@color/miuix_text_primary</item>
        <item name="android:textColorSecondary">@color/miuix_text_secondary</item>
        <item name="toolbarStyle">@style/Miuix.Toolbar</item>
    </style>

    <!-- miuix toolbar is shadowless, untinted, with a large medium-weight title -->
    <style name="Miuix.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@android:color/transparent</item>
        <item name="titleTextAppearance">@style/Miuix.Toolbar.Title</item>
    </style>

    <style name="Miuix.Toolbar.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/miuix_text_primary</item>
    </style>

    <!-- Phone floating window: light/dark translucent panel close to MIUI -->
    <style name="Theme.AADisplay.Window" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/miuix_blue</item>
        <item name="colorPrimaryContainer">@color/window_panel</item>
        <item name="colorOnPrimaryContainer">@color/window_icon</item>
        <item name="colorOutline">@color/window_panel_stroke</item>
    </style>

</resources>
