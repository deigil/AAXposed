<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Floating window (MIUI style: pill-shaped, large corners, comfortable spacing) -->
    <dimen name="window_btn_size">44dp</dimen>
    <dimen name="window_btn_padding">11dp</dimen>
    <dimen name="window_btn_gap">2dp</dimen>
    <dimen name="window_panel_padding">5dp</dimen>
    <dimen name="window_panel_radius">26dp</dimen>
    <dimen name="window_handle_radius">22dp</dimen>
    <dimen name="window_stroke_width">0.5dp</dimen>
    <!--
        Shadow elevation of the pill/panel. Same constraint as the mirror window: shadow spread is ~1.5x elevation,
        must be smaller than window_shadow_pad on the root layout, otherwise the gradient will be clipped by the window bounds.
    -->
    <dimen name="window_panel_elevation">3dp</dimen>
    <!-- Transparent padding reserved on controller root layout for card shadow; keep in sync with applyControllerDockPosition -->
    <dimen name="window_shadow_pad">6dp</dimen>
    <dimen name="window_destroy_text_size">11sp</dimen>

    <!-- Phone mirror window (MIUI freeform) -->
    <dimen name="mirror_card_radius">18dp</dimen>
    <!--
        Card shadow elevation. Platform spot shadow blur radius and downward offset scale linearly with elevation;
        at 12dp the shadow spreads >15dp, exceeding mirror_window_shadow_pad and getting clipped into a visible straight edge.
        Use 4dp: shadow spread is ~6dp, fitting completely inside the padding.
    -->
    <dimen name="mirror_card_elevation">4dp</dimen>
    <dimen name="mirror_nav_btn_size">48dp</dimen>
    <dimen name="mirror_nav_btn_padding">12dp</dimen>
    <!-- Card shadow relies on root layout padding so it is not clipped by window bounds -->
    <dimen name="mirror_window_shadow_pad">10dp</dimen>
    <dimen name="mirror_top_bar_height">34dp</dimen>
    <dimen name="mirror_top_btn_size">28dp</dimen>
    <dimen name="mirror_drag_pill_width">34dp</dimen>
    <dimen name="mirror_drag_pill_height">4dp</dimen>
    <dimen name="mirror_resize_size">34dp</dimen>
    <!-- Minimum mirror window width to prevent shrinking out of sight -->
    <dimen name="mirror_min_width">180dp</dimen>

    <!-- Mirror window recents panel (icon mode, no task snapshots) -->
    <dimen name="mirror_recent_icon_size">40dp</dimen>
    <dimen name="mirror_recent_item_padding">6dp</dimen>
    <!-- Reference width of a single icon item, used to calculate grid column count -->
    <dimen name="mirror_recent_item_width">62dp</dimen>
</resources>
