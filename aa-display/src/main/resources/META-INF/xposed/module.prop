# libxposed (modern Xposed API) module property file.
# The framework identifies modern modules via entries under META-INF/xposed/,
# so packaging cannot exclude META-INF/** entirely.
#
# targetApiVersion is pinned to 101 (and compile-time api:101.0.0):
# VectorModuleClassLoader only blocks de.robv.android.xposed.* when targetApiVersion >= 102.
# Since this module's hooks rely on EzXHelper (which uses XposedBridge / XC_MethodHook),
# declaring 101 allows the modern entry point and legacy bridge to coexist cleanly.
# 101 and 102 have identical constructors, callback signatures, and IXposedService transaction codes.
minApiVersion=101
targetApiVersion=101
